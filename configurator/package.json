{
  "name": "fcu-configurator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AeroForge Configurator for the ESP32-S3 Mini FCU.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "nw": "nw dist",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-windows.ps1",
    "sign:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "buffer": "6.0.3",
    "serialport": "13.0.0",
    "three": "0.177.0",
    "vite": "6.4.3",
    "vue": "3.5.17"
  },
  "devDependencies": {
    "nw": "0.98.0"
  }
}
