#pragma once
// =============================================================================
// WiFi build secrets — TEMPLATE.
//
// Copy this file to `src/pidweb_secrets.h` (which is .gitignored) and fill in
// real values. ANY WiFi-enabled build #errors at compile time if
// `src/pidweb_secrets.h` is missing or any macro is undefined:
//   - the bench tuner            [env:esp32-s3-mini-pidweb]
//   - the flight wireless image  [env:esp32-s3-mini-wireless]
//     (FCU_ENABLE_WIFI_LOGGING / FCU_ENABLE_WIFI_OTA — see wifi_manager.h)
//
//   cp src/pidweb_secrets.h.example src/pidweb_secrets.h
//
// NEVER commit the filled-in header. These are credentials.
// The plain flight build (`[env:esp32-s3-mini]`) does NOT include this file.
// =============================================================================

// The bench tuner hosts its OWN access point (SoftAP): the FCU broadcasts this
// network and serves the tuner at the fixed AP IP (FCU_PID_AP_IP, default
// 192.168.4.1, in src/pid_webserver_enabled.cpp). Connect a phone/laptop to it
// and open  http://192.168.4.1/?token=<FCU_PID_AUTH_TOKEN>
// PASS must be 8..63 chars for WPA2; shorter/empty => OPEN (unsecured) network.
//
// NOTE: the wireless flight image (FCU_ENABLE_WIFI_LOGGING / OTA, wifi_manager)
// still JOINS these as a station — set them to your router there if you use it.
#define FCU_PID_WIFI_SSID "FCU-PIDWEB"
#define FCU_PID_WIFI_PASS "12345678"

// Shared secret required on every mutating HTTP request (PUT/POST) as the
// `X-Auth-Token` header. The same token guards the OTA upload endpoint
// (POST /ota) in the wireless flight build. For the bench tuner, open the
// page as  http://<fcu-ip>/?token=<this>  so it attaches automatically.
// Use a long random string.
#define FCU_PID_AUTH_TOKEN "change-me-to-a-long-random-string"
